<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f3f7fb">
  <title>Weather — Tokyo</title>
  <style>
    :root {
      color-scheme: light dark;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 15px;
      font-synthesis: none;
      text-rendering: optimizeLegibility;
      --page: #eaf2fb;
      --surface: rgba(255, 255, 255, .82);
      --surface-solid: #fff;
      --text: #172638;
      --muted: #738397;
      --line: #e5ebf1;
      --accent: #ef9c43;
      --accent-soft: #fff0dc;
      --shadow: 0 24px 70px rgba(44, 69, 98, .12);
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --page: #0b1424;
        --surface: rgba(27, 40, 54, .88);
        --surface-solid: #1b2836;
        --text: #e9f0f7;
        --muted: #9aabba;
        --line: #30404f;
        --accent: #ffc06d;
        --accent-soft: #3b3022;
        --shadow: 0 24px 70px rgba(0, 0, 0, .28);
      }
    }

    * { box-sizing: border-box; }
    body {
      min-height: 100vh;
      margin: 0;
      padding: 36px 18px;
      display: grid;
      place-items: center;
      color: var(--text);
      background:
        radial-gradient(ellipse at 12% 18%, rgba(75, 151, 255, .2), transparent 36%),
        radial-gradient(ellipse at 88% 78%, rgba(71, 117, 221, .17), transparent 38%),
        linear-gradient(145deg, #edf5ff 0%, #e5edf9 48%, #eef1fa 100%);
      transition: background-color .25s ease;
    }

    @media (prefers-color-scheme: dark) {
      body {
        background:
          radial-gradient(ellipse at 12% 18%, rgba(34, 105, 204, .26), transparent 38%),
          radial-gradient(ellipse at 88% 78%, rgba(87, 70, 181, .2), transparent 40%),
          linear-gradient(145deg, #0a1426 0%, #101d34 52%, #11182e 100%);
      }
    }

    .app { width: min(100%, 440px); }
    .topline {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin: 0 4px 15px;
      color: var(--muted);
      font-size: .76rem;
      font-weight: 700;
      letter-spacing: .12em;
      text-transform: uppercase;
    }
    .brand { display: flex; align-items: center; gap: 8px; }
    .brand-mark {
      display: grid;
      width: 24px;
      height: 24px;
      place-items: center;
      border-radius: 8px;
      color: #fff;
      background: var(--accent);
      font-size: .9rem;
      letter-spacing: 0;
    }
    .live-state { display: flex; align-items: center; gap: 7px; letter-spacing: .07em; }
    .live-dot { width: 7px; height: 7px; border-radius: 50%; background: #53b887; }

    .panel {
      overflow: hidden;
      border: 1px solid color-mix(in srgb, var(--line) 80%, transparent);
      border-radius: 28px;
      background: var(--surface);
      box-shadow: var(--shadow);
      backdrop-filter: blur(18px);
    }
    .search-wrap { padding: 22px 22px 0; }
    .search {
      display: flex;
      align-items: center;
      gap: 10px;
      height: 46px;
      padding: 0 13px;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: var(--surface-solid);
      transition: border-color .2s, box-shadow .2s;
    }
    .search:focus-within {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent);
    }
    .search-icon { flex: 0 0 auto; color: var(--muted); }
    .search input {
      width: 100%;
      min-width: 0;
      border: 0;
      outline: 0;
      color: var(--text);
      background: transparent;
      font: inherit;
    }
    .search input::placeholder { color: var(--muted); }
    .search button {
      padding: 6px 10px;
      border: 0;
      border-radius: 9px;
      color: #fff;
      background: var(--text);
      font: inherit;
      font-size: .78rem;
      font-weight: 700;
      cursor: pointer;
      transition: opacity .2s;
    }
    .search button:hover { opacity: .8; }
    .search button:disabled { opacity: .55; cursor: wait; }

    .current { padding: 25px 26px 27px; }
    .location-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
    .eyebrow {
      margin: 0 0 5px;
      color: var(--muted);
      font-size: .78rem;
      font-weight: 650;
      letter-spacing: .1em;
      text-transform: uppercase;
    }
    h1 { margin: 0; font-size: 1.6rem; font-weight: 730; letter-spacing: -.04em; }
    .location { display: flex; align-items: center; gap: 6px; color: var(--muted); font-size: .88rem; }
    .condition-icon { margin: 12px 1px 0; font-size: 3rem; line-height: 1; }
    .temperature-row { display: flex; align-items: flex-start; gap: 10px; }
    .temperature { font-size: clamp(5.4rem, 22vw, 7.3rem); line-height: .95; font-weight: 300; letter-spacing: -.09em; }
    .unit { margin-top: 9px; color: var(--muted); font-size: 1.45rem; font-weight: 400; }
    .condition { margin: 8px 0 0 4px; font-size: 1rem; font-weight: 650; }
    .feels { margin: 5px 0 0 4px; color: var(--muted); font-size: .86rem; }
    .detail-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      margin-top: 25px;
      padding-top: 18px;
      border-top: 1px solid var(--line);
    }
    .detail { text-align: center; }
    .detail-icon { display: block; margin-bottom: 5px; font-size: 1rem; }
    .detail-label { display: block; margin-bottom: 3px; color: var(--muted); font-size: .7rem; }
    .detail-value { font-size: .85rem; font-weight: 700; }

    .forecast {
      padding: 21px 22px 23px;
      border-top: 1px solid var(--line);
      background: color-mix(in srgb, var(--surface-solid) 44%, transparent);
    }
    .forecast-heading { display: flex; align-items: center; justify-content: space-between; margin: 0 3px 14px; }
    h2 { margin: 0; font-size: .93rem; font-weight: 720; }
    .forecast-note { color: var(--muted); font-size: .7rem; }
    .days { display: grid; grid-template-columns: repeat(5, 1fr); gap: 7px; }
    .day {
      min-width: 0;
      padding: 11px 4px 12px;
      border: 1px solid var(--line);
      border-radius: 15px;
      background: var(--surface-solid);
      text-align: center;
    }
    .day-name { color: var(--muted); font-size: .68rem; font-weight: 650; }
    .day-icon { margin: 9px 0; font-size: 1.32rem; line-height: 1; }
    .day-high { font-size: .75rem; font-weight: 750; }
    .day-low { margin-top: 3px; color: var(--muted); font-size: .7rem; }
    .credit { margin: 13px 0 0; color: var(--muted); text-align: center; font-size: .69rem; }
    .message { min-height: 1.1rem; margin: 9px 2px 0; color: var(--muted); font-size: .78rem; }
    .message.error { color: #dc645a; }

    @media (max-width: 380px) {
      body { padding: 22px 12px; }
      .search-wrap { padding: 17px 17px 0; }
      .current { padding: 22px 21px 24px; }
      .forecast { padding: 18px 16px 20px; }
      .days { gap: 5px; }
      .day { padding-inline: 2px; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; }
    }
  </style>
</head>
<body>
  <main class="app">
    <div class="topline">
      <div class="brand"><span class="brand-mark" aria-hidden="true">☀</span> Skycast</div>
      <div class="live-state"><span class="live-dot" aria-hidden="true"></span><span id="data-status">LIVE WEATHER</span></div>
    </div>
    <section class="panel" aria-label="Weather forecast">
      <div class="search-wrap">
        <form class="search" id="search-form" role="search">
          <svg class="search-icon" aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none">
            <circle cx="10.8" cy="10.8" r="6.8" stroke="currentColor" stroke-width="1.8"></circle>
            <path d="m16 16 4.2 4.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
          </svg>
          <input id="city-input" type="search" placeholder="Search a city..." aria-label="Search a city" autocomplete="off">
          <button id="search-button" type="submit">Search</button>
        </form>
        <p class="message" id="message" aria-live="polite"></p>
      </div>
      <div class="current">
        <div class="location-row">
          <div>
            <p class="eyebrow" id="today-label">Today</p>
            <h1 id="city-name">Tokyo</h1>
            <div class="location"><span aria-hidden="true">⌖</span><span id="region-name">Japan</span></div>
          </div>
          <div class="condition-icon" id="current-icon" aria-hidden="true">☀️</div>
        </div>
        <div class="temperature-row">
          <div class="temperature" id="temperature">22</div>
          <div class="unit">°C</div>
        </div>
        <p class="condition" id="condition">Mostly sunny</p>
        <p class="feels" id="feels-like">Feels like 24°</p>
        <div class="detail-row">
          <div class="detail">
            <span class="detail-icon" aria-hidden="true">💧</span>
            <span class="detail-label">Humidity</span>
            <span class="detail-value" id="humidity">62%</span>
          </div>
          <div class="detail">
            <span class="detail-icon" aria-hidden="true">🌬️</span>
            <span class="detail-label">Wind</span>
            <span class="detail-value" id="wind">12 km/h</span>
          </div>
          <div class="detail">
            <span class="detail-icon" aria-hidden="true">☔</span>
            <span class="detail-label">Rain chance</span>
            <span class="detail-value" id="rain">10%</span>
          </div>
        </div>
      </div>
      <div class="forecast">
        <div class="forecast-heading">
          <h2>5-day forecast</h2>
          <span class="forecast-note">DAILY OUTLOOK</span>
        </div>
        <div class="days" id="forecast-days" aria-label="Five-day forecast"></div>
      </div>
    </section>
    <p class="credit">Weather data by Open-Meteo</p>
  </main>

  <script>
    const fallback = {
      current: { temperature_2m: 22, apparent_temperature: 24, relative_humidity_2m: 62, wind_speed_10m: 12, precipitation_probability: 10, weather_code: 2 },
      daily: {
        time: ["2026-10-09", "2026-10-10", "2026-10-11", "2026-10-12", "2026-10-13"],
        temperature_2m_max: [23, 21, 22, 24, 20],
        temperature_2m_min: [17, 16, 16, 18, 15],
        weather_code: [2, 61, 3, 1, 61]
      },
      timezone: "Asia/Tokyo"
    };

    const weatherTypes = [
      { codes: [0], label: "Clear sky", icon: "☀️", accent: "#ef9c43", soft: "#fff0dc" },
      { codes: [1], label: "Mainly clear", icon: "🌤️", accent: "#ef9c43", soft: "#fff0dc" },
      { codes: [2], label: "Partly cloudy", icon: "⛅", accent: "#e7a24e", soft: "#fff1df" },
      { codes: [3], label: "Overcast", icon: "☁️", accent: "#7896b4", soft: "#e8f0f7" },
      { codes: [45, 48], label: "Foggy", icon: "🌫️", accent: "#8296a8", soft: "#e9eff3" },
      { codes: [51, 53, 55, 56, 57], label: "Drizzle", icon: "🌦️", accent: "#5899bd", soft: "#e4f3fa" },
      { codes: [61, 63, 65, 66, 67], label: "Rain", icon: "🌧️", accent: "#5486c0", soft: "#e5edfa" },
      { codes: [71, 73, 75, 77], label: "Snow", icon: "🌨️", accent: "#7ca9d4", soft: "#e7f4ff" },
      { codes: [80, 81, 82], label: "Rain showers", icon: "🌦️", accent: "#5486c0", soft: "#e5edfa" },
      { codes: [85, 86], label: "Snow showers", icon: "🌨️", accent: "#7ca9d4", soft: "#e7f4ff" },
      { codes: [95, 96, 99], label: "Thunderstorm", icon: "⛈️", accent: "#8275b8", soft: "#eeeafa" }
    ];

    const byId = id => document.getElementById(id);
    function weatherFor(code) {
      return weatherTypes.find(type => type.codes.includes(code)) || weatherTypes[3];
    }
    function applyAccent(weather) {
      document.documentElement.style.setProperty("--accent", weather.accent);
      document.documentElement.style.setProperty("--accent-soft", weather.soft);
    }
    function render(data, place, isFallback) {
      const current = data.current;
      const condition = weatherFor(current.weather_code);
      applyAccent(condition);
      byId("city-name").textContent = place.name;
      byId("region-name").textContent = [place.admin1, place.country].filter(Boolean).join(", ") || place.country || "";
      byId("current-icon").textContent = condition.icon;
      byId("condition").textContent = condition.label;
      byId("temperature").textContent = Math.round(current.temperature_2m);
      byId("feels-like").textContent = `Feels like ${Math.round(current.apparent_temperature)}°`;
      byId("humidity").textContent = `${Math.round(current.relative_humidity_2m)}%`;
      byId("wind").textContent = `${Math.round(current.wind_speed_10m)} km/h`;
      byId("rain").textContent = `${Math.round(current.precipitation_probability ?? 0)}%`;

      const dateOptions = { weekday: "short", month: "short", day: "numeric", timeZone: data.timezone || "auto" };
      const today = current.time ? new Date(`${current.time.slice(0, 10)}T12:00:00Z`) : new Date();
      byId("today-label").textContent = new Intl.DateTimeFormat("en", { weekday: "long", month: "long", day: "numeric", timeZone: data.timezone || "auto" }).format(today);
      byId("forecast-days").innerHTML = data.daily.time.slice(0, 5).map((date, index) => {
        const outlook = weatherFor(data.daily.weather_code[index]);
        const day = new Intl.DateTimeFormat("en", dateOptions).format(new Date(`${date}T12:00:00Z`)).split(",")[0];
        return `<div class="day"><div class="day-name">${day}</div><div class="day-icon" aria-label="${outlook.label}">${outlook.icon}</div><div class="day-high">${Math.round(data.daily.temperature_2m_max[index])}°</div><div class="day-low">${Math.round(data.daily.temperature_2m_min[index])}°</div></div>`;
      }).join("");
      byId("data-status").textContent = isFallback ? "OFFLINE FORECAST" : "LIVE WEATHER";
      byId("message").textContent = isFallback ? "Showing a sample forecast — live weather is unavailable." : "";
      byId("message").classList.toggle("error", isFallback);
      document.title = `Weather — ${place.name}`;
    }

    async function loadCity(query, isInitial = false) {
      const button = byId("search-button");
      const message = byId("message");
      button.disabled = true;
      button.textContent = "…";
      message.classList.remove("error");
      message.textContent = isInitial ? "Loading Tokyo weather…" : "Searching…";
      try {
        let place;
        if (isInitial) {
          place = { name: "Tokyo", admin1: "Tokyo", country: "Japan", latitude: 35.6762, longitude: 139.6503 };
        } else {
          const geoResponse = await fetch(`https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(query)}&count=1&language=en&format=json`);
          if (!geoResponse.ok) throw new Error("City search is unavailable.");
          const geo = await geoResponse.json();
          if (!geo.results?.length) {
            message.textContent = `We couldn't find “${query}”. Try another city.`;
            message.classList.add("error");
            return;
          }
          place = geo.results[0];
        }

        const params = new URLSearchParams({
          latitude: place.latitude,
          longitude: place.longitude,
          current: "temperature_2m,relative_humidity_2m,apparent_temperature,precipitation_probability,weather_code,wind_speed_10m",
          daily: "weather_code,temperature_2m_max,temperature_2m_min",
          forecast_days: "6",
          timezone: "auto"
        });
        const response = await fetch(`https://api.open-meteo.com/v1/forecast?${params}`);
        if (!response.ok) throw new Error("Weather service is unavailable.");
        const data = await response.json();
        data.daily.time = data.daily.time.slice(1);
        data.daily.weather_code = data.daily.weather_code.slice(1);
        data.daily.temperature_2m_max = data.daily.temperature_2m_max.slice(1);
        data.daily.temperature_2m_min = data.daily.temperature_2m_min.slice(1);
        render(data, place, false);
      } catch (error) {
        render(fallback, isInitial ? { name: "Tokyo", admin1: "Tokyo", country: "Japan" } : { name: query, country: "Sample forecast" }, true);
      } finally {
        button.disabled = false;
        button.textContent = "Search";
      }
    }

    byId("search-form").addEventListener("submit", event => {
      event.preventDefault();
      const query = byId("city-input").value.trim();
      if (query) loadCity(query);
    });
    loadCity("Tokyo", true);
  </script>
</body>
</html>
